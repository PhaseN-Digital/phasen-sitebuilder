{
  "name": "phasen-sitebuilder",
  "productName": "PhaseN Site Builder",
  "version": "0.4.1",
  "private": true,
  "description": "Desktop CMS that builds and publishes small websites to Cloudflare Workers.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "test": "node test.js",
    "test:regression": "node test/regression.js",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "wrangler": "^4.48.0"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "digital.phasen.sitebuilder",
    "productName": "PhaseN Site Builder",
    "asar": false,
    "files": [
      "main.js",
      "preload.js",
      "app/**",
      "lib/**",
      "themes/**",
      "runtime/**",
      "!node_modules/@img/**",
      "!node_modules/sharp/**"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true
    },
    "mac": {
      "target": "dmg",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "category": "public.app-category.productivity"
    },
    "afterPack": "scripts/after-pack.js"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "electron-winstaller": true,
    "esbuild": true,
    "fsevents": true,
    "workerd": true
  }
}
