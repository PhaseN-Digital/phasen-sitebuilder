{
  "name": "phasen-sitebuilder",
  "productName": "PhaseN Site Builder",
  "version": "0.9.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "description": "Desktop CMS that builds and publishes small websites to Cloudflare Workers.",
  "homepage": "https://phasen.digital",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "predist": "node scripts/licences.js",
    "dist": "electron-builder --publish never",
    "test": "node test.js",
    "test:regression": "node test/regression.js",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "isomorphic-git": "1.44.4",
    "marked": "18.1.1",
    "quill": "2.0.3",
    "wrangler": "^4.48.0"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "digital.phasen.sitebuilder",
    "productName": "PhaseN Site Builder",
    "asar": false,
    "icon": "build/icon.png",
    "files": [
      "main.js",
      "preload.js",
      "app/**",
      "lib/**",
      "build/icon.png",
      "themes/**",
      "runtime/**",
      "LICENSE",
      "THIRD-PARTY-NOTICES.txt",
      "!node_modules/@img/**",
      "!node_modules/sharp/**"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true
    },
    "mac": {
      "target": "dmg",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "category": "Utility",
      "maintainer": "PhaseN Digital <enquiries@phasen.digital>",
      "vendor": "PhaseN Digital",
      "synopsis": "Build and publish small websites to Cloudflare"
    },
    "afterPack": "scripts/after-pack.js"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "electron-winstaller": true,
    "esbuild": true,
    "fsevents": true,
    "workerd": true
  }
}
